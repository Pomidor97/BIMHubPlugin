<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <Configurations>Debug;Release</Configurations>
    <UseWPF>true</UseWPF>
    <RevitVersion Condition="'$(RevitVersion)' == ''">2023</RevitVersion>
    <RevitInstallDir Condition="'$(RevitInstallDir)' == ''">C:\Program Files\Autodesk\Revit $(RevitVersion)</RevitInstallDir>
    <OutputPath>bin\Revit$(RevitVersion)\$(Configuration)\</OutputPath>
    <IntermediateOutputPath>obj\Revit$(RevitVersion)\$(Configuration)\</IntermediateOutputPath>
    <DeployAddin Condition="'$(DeployAddin)' == ''">false</DeployAddin>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'=='Debug'">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
  </PropertyGroup>

  <!-- Revit 2023 References -->
  <ItemGroup>
    <Reference Include="RevitAPI">
      <HintPath>$(RevitInstallDir)\RevitAPI.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="RevitAPIUI">
      <HintPath>$(RevitInstallDir)\RevitAPIUI.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <!-- NuGet Packages -->
  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="System.Net.Http" Version="4.3.4" />
  </ItemGroup>

  <!-- DPAPI (ProtectedData) для локального шифрования кэша JWT-токена -->
  <ItemGroup>
    <Reference Include="System.Security" />
  </ItemGroup>
  <ItemGroup>
    <None Remove="Resources\icon.png" />
    <Resource Include="Resources\icon.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Resource>
  </ItemGroup>

  <!-- Copy .addin file to Revit AddIns folder -->
  <Target Name="ValidateRevitSdk" BeforeTargets="ResolveReferences">
    <Error Condition="'$(RevitVersion)' != '2023' And '$(RevitVersion)' != '2024'" Text="Supported RevitVersion values: 2023, 2024." />
    <Error Condition="!Exists('$(RevitInstallDir)\RevitAPI.dll')" Text="Revit API not found. Set RevitInstallDir to the installed Revit $(RevitVersion) SDK directory." />
  </Target>
  <Target Name="CopyAddInFile" AfterTargets="Build" Condition="'$(DeployAddin)' == 'true'">
    <Copy SourceFiles="$(ProjectDir)BIMHubPlugin.addin" 
          DestinationFolder="$(AppData)\Autodesk\Revit\Addins\$(RevitVersion)" />
  </Target>

  <!-- Copy DLL to Revit AddIns folder -->
  <Target Name="CopyDLLFiles" AfterTargets="Build" Condition="'$(DeployAddin)' == 'true'">
    <ItemGroup>
      <FilesToCopy Include="$(OutDir)**\*.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(FilesToCopy)" 
          DestinationFolder="$(AppData)\Autodesk\Revit\Addins\$(RevitVersion)\BIMHubPlugin" />
  </Target>

</Project>
