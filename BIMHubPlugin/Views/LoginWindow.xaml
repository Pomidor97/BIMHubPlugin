<Window x:Class="BIMHubPlugin.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Вход в BIMHelpDesk"
        Width="360"
        Height="240"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <StackPanel Margin="20">
        <TextBlock Text="Логин (AD):" Margin="0,0,0,4"/>
        <TextBox x:Name="UsernameBox" Height="26" />

        <TextBlock Text="Пароль:" Margin="0,12,0,4"/>
        <PasswordBox x:Name="PasswordBox" Height="26" />

        <TextBlock x:Name="ErrorText"
                   Foreground="Red"
                   TextWrapping="Wrap"
                   Margin="0,10,0,0"
                   Visibility="Collapsed"/>

        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button x:Name="LoginButton"
                    Content="Войти"
                    Width="90"
                    Margin="0,0,10,0"
                    Click="LoginButton_Click"
                    IsDefault="True"/>
            <Button Content="Отмена"
                    Width="90"
                    IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
