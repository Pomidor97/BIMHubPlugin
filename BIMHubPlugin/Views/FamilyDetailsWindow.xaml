<Window x:Class="BIMHubPlugin.Views.FamilyDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Детализация семейства"
        Width="500"
        Height="650"
        MinWidth="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">

    <DockPanel Margin="15">
        
        <!-- Кнопки снизу — фиксируем первыми через DockPanel -->
        <StackPanel DockPanel.Dock="Bottom"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,10,0,0">
            <Button Content="Загрузить"
                    Width="120"
                    Margin="0,0,10,0"
                    Command="{Binding LoadCommand}"/>
            <Button Content="Закрыть"
                    Width="80"
                    Command="{Binding CloseCommand}"/>
        </StackPanel>

        <!-- Превью фиксированной высоты -->
        <Image DockPanel.Dock="Top"
               Source="{Binding PreviewImage}"
               Height="180"
               Stretch="Uniform"
               Margin="0,0,0,10"/>

        <!-- Остаток пространства — скроллируемый контент -->
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <TextBlock Text="{Binding Family.Name}"
                           FontSize="16"
                           FontWeight="Bold"
                           TextWrapping="Wrap"/>

                <TextBlock Text="Категория:" 
                           FontWeight="SemiBold" 
                           Margin="0,10,0,2"/>
                <TextBlock Text="{Binding Family.CategoryName}"
                           TextWrapping="Wrap"/>

                <TextBlock Text="Производитель:" 
                           FontWeight="SemiBold" 
                           Margin="0,10,0,2"/>
                <TextBlock Text="{Binding Family.ManufacturerName}"
                           TextWrapping="Wrap"/>

                <TextBlock Text="Описание:" 
                           FontWeight="SemiBold" 
                           Margin="0,10,0,2"/>
                <TextBlock Text="{Binding Family.Description}"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </ScrollViewer>

    </DockPanel>
</Window>